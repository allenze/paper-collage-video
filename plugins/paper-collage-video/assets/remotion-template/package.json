{
  "name": "paper-collage-video-workspace",
  "version": "0.15.0-dev.1",
  "description": "Configuration-driven paper-collage video pipeline and Codex plugin built with Remotion.",
  "private": true,
  "type": "module",
  "author": "Paper Collage Video Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberlesterr/paper-collage-video.git"
  },
  "bugs": {
    "url": "https://github.com/cyberlesterr/paper-collage-video/issues"
  },
  "homepage": "https://github.com/cyberlesterr/paper-collage-video#readme",
  "keywords": [
    "remotion",
    "codex-plugin",
    "video",
    "paper-collage",
    "animation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets:rasterize": "node scripts/rasterize-assets.mjs",
    "assets:process-sheet": "node scripts/process-character-sheet.mjs",
    "assets:process-state-sheet": "node scripts/process-state-sheet.mjs",
    "provider:status": "node scripts/provider-status.mjs",
    "provider:select": "node scripts/provider-select.mjs",
    "provider:run": "node scripts/provider-run.mjs",
    "provider:request": "node scripts/provider-request.mjs",
    "provider:record": "node scripts/provider-record.mjs",
    "provider:recover-record": "node scripts/provider-recover-record.mjs",
    "provider:reuse": "node scripts/provider-reuse.mjs",
    "provider:attempt": "node scripts/provider-attempt.mjs",
    "project:new": "node scripts/project-new.mjs",
    "project:plan": "node scripts/project-plan.mjs",
    "project:storyboard": "node scripts/project-storyboard.mjs",
    "project:revise-preview-directing": "node scripts/project-revise-preview-directing.mjs",
    "project:semantic-contracts": "node scripts/project-semantic-contracts.mjs",
    "project:confirm-concept": "node scripts/project-confirm-concept.mjs",
    "project:quality": "node scripts/project-metrics-run.mjs --category=deterministic-check --operation=quality-command --script=scripts/project-quality.mjs --slug-index=0 --",
    "project:composition-proof": "node scripts/project-metrics-run.mjs --category=evidence-render --operation=composition-proof --script=scripts/project-composition-proof.mjs --slug-index=0 --",
    "project:metrics": "node scripts/project-metrics.mjs",
    "project:resume": "node scripts/project-status.mjs --resume-json",
    "project:status": "node scripts/project-status.mjs",
    "project:handoff-check": "node scripts/project-handoff-check.mjs",
    "project:checkpoint": "node scripts/project-checkpoint.mjs",
    "project:asset-lifecycle": "node scripts/project-asset-lifecycle.mjs",
    "project:review-sync": "node scripts/project-review-sync.mjs",
    "project:advance": "node scripts/project-advance.mjs",
    "project:assets-ready": "node scripts/project-metrics-run.mjs --category=deterministic-check --operation=assets-ready --script=scripts/project-assets-ready.mjs --slug-index=0 --",
    "project:audio-preflight": "node scripts/project-metrics-run.mjs --category=deterministic-check --operation=audio-preflight --script=scripts/project-audio-preflight.mjs --slug-index=0 --",
    "project:audio-calibration": "node scripts/project-metrics-run.mjs --category=deterministic-check --operation=audio-calibration --script=scripts/project-audio-calibration.mjs --slug-index=0 --",
    "project:sync": "node scripts/project-sync.mjs",
    "project:subtitles": "node scripts/project-subtitles.mjs",
    "project:validate": "node scripts/project-metrics-run.mjs --category=deterministic-check --operation=validate --script=scripts/project-validate.mjs --slug-index=0 --",
    "project:preview": "node scripts/project-metrics-run.mjs --category=video-render --operation=preview-render --script=scripts/project-render.mjs --slug-index=1 -- preview",
    "project:render": "node scripts/project-metrics-run.mjs --category=video-render --operation=final-render --script=scripts/project-render.mjs --slug-index=1 -- render",
    "project:report": "node scripts/project-metrics-run.mjs --category=deterministic-check --operation=report --script=scripts/project-report.mjs --slug-index=0 --",
    "style:proof": "node scripts/project-metrics-run.mjs --category=evidence-render --operation=style-proof --script=scripts/style-motion-proof.mjs --slug-index=0 --",
    "doctor": "node scripts/project-doctor.mjs",
    "sample:vox": "remotion render src/index.ts Paper-Collage dist/vox-primitives/preview.mp4 --props=fixtures/vox-primitives/project.json --codec=h264",
    "sample:vox:verify": "node scripts/verify-vox-sample.mjs",
    "dev": "remotion studio src/index.ts --props=projects/starter-demo/project.json",
    "check": "tsc --noEmit",
    "bundle": "remotion bundle src/index.ts",
    "test": "node --test tests/*.test.mjs",
    "render": "npm run project:render -- starter-demo",
    "render:preview": "npm run project:preview -- starter-demo"
  },
  "dependencies": {
    "@remotion/cli": "4.0.490",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.490"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.3",
    "typescript": "5.9.3"
  }
}
