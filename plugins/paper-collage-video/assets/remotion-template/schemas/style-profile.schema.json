{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/style-profile.schema.json",
  "title": "Executable Paper Collage Style Profile v1",
  "$defs": {
    "theme": {
      "type": "object",
      "required": [
        "canvas",
        "sceneBackground",
        "accent",
        "ink",
        "subtitle",
        "subtitleBackground",
        "paperEdge",
        "foreground",
        "texture",
        "cutout"
      ],
      "properties": {
        "canvas": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "sceneBackground": {"type": "string"},
        "accent": {"type": "string"},
        "ink": {"type": "string"},
        "subtitle": {"type": "string"},
        "subtitleBackground": {"type": "string"},
        "paperEdge": {"type": "string"},
        "foreground": {"type": "string"},
        "texture": {"type": "string", "minLength": 1},
        "fontFamily": {"type": "string"},
        "fontFile": {"type": "string"},
        "cutout": {"$ref": "#/$defs/cutout"}
      },
      "additionalProperties": false
    },
    "cutout": {
      "type": "object",
      "required": [
        "edgeWidthPx",
        "shadowOffsetXPx",
        "shadowOffsetYPx",
        "shadowBlurPx",
        "shadowColor"
      ],
      "properties": {
        "edgeWidthPx": {"type": "number", "minimum": 0, "maximum": 16},
        "shadowOffsetXPx": {"type": "number", "minimum": -32, "maximum": 32},
        "shadowOffsetYPx": {"type": "number", "minimum": -32, "maximum": 32},
        "shadowBlurPx": {"type": "number", "minimum": 0, "maximum": 48},
        "shadowColor": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": ["schemaVersion", "generation", "motion", "render", "quality"],
      "properties": {
        "schemaVersion": {"const": 1},
        "generation": {
          "type": "object",
          "required": [
            "promptDirectives",
            "negativeDirectives",
            "compositionPrinciples",
            "preferredSurfaces"
          ],
          "properties": {
            "promptDirectives": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "negativeDirectives": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "compositionPrinciples": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "preferredSurfaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "alpha",
                  "chroma-key",
                  "opaque",
                  "layer-sheet",
                  "seamless-strip-x"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "required": ["pacing", "preferredIdlePresets", "preferredTransitions"],
          "properties": {
            "pacing": {"enum": ["gentle", "playful", "measured"]},
            "preferredIdlePresets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["float", "breathe", "drift", "sway", "still"]}
            },
            "preferredTransitions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "paper-wipe",
                  "dip-to-paper",
                  "paper-slide",
                  "torn-wipe",
                  "paper-iris",
                  "page-turn",
                  "paper-shutters"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "render": {
          "type": "object",
          "required": ["theme"],
          "properties": {
            "theme": {"$ref": "#/$defs/theme"}
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "required": [
            "requiredAssetChecks",
            "requiredCompositeChecks",
            "reviewFocus"
          ],
          "properties": {
            "requiredAssetChecks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": {"const": "style-profile-conformant"},
              "items": {
                "enum": ["style-consistent", "style-profile-conformant"]
              }
            },
            "requiredCompositeChecks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": {"const": "style-profile-consistent"},
              "items": {"enum": ["style-profile-consistent"]}
            },
            "reviewFocus": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "label",
        "summary",
        "catalogVersion",
        "catalogFingerprint",
        "profileFingerprint",
        "referenceImage",
        "generation",
        "motion",
        "render",
        "quality"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {
          "enum": [
            "childrens-picture-book-paper",
            "hand-drawn-cutout-explainer",
            "archival-collage"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "catalogVersion": {"type": "string", "minLength": 1},
        "catalogFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profileFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referenceImage": {
          "type": "string",
          "pattern": "^style-catalog/[a-z0-9-]+\\.png$"
        },
        "generation": {
          "$ref": "#/$defs/definition/properties/generation"
        },
        "motion": {"$ref": "#/$defs/definition/properties/motion"},
        "render": {"$ref": "#/$defs/definition/properties/render"},
        "quality": {"$ref": "#/$defs/definition/properties/quality"}
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "catalogVersion",
        "profileFingerprint",
        "directives"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {
          "enum": [
            "childrens-picture-book-paper",
            "hand-drawn-cutout-explainer",
            "archival-collage"
          ]
        },
        "catalogVersion": {"type": "string", "minLength": 1},
        "profileFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "directives": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
