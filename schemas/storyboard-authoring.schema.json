{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/storyboard-authoring.schema.json",
  "title": "Paper Collage Storyboard Authoring v5",
  "description": "Author treatments only. compositionPlan, directing, fingerprints, and budget demand are compiler-owned.",
  "type": "object",
  "required": ["arc", "style", "scenes", "sceneTransitions"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 5},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["pending", "ready"]},
    "arc": {"type": "string"},
    "style": {
      "type": "object",
      "required": ["visualThesis", "compositionRules", "motionLanguage", "layerStrategy"],
      "properties": {
        "visualThesis": {"type": "string"},
        "compositionRules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "motionLanguage": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "layerStrategy": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "title", "narrativeRole", "message", "blueprint", "estimatedDurationSeconds", "beats", "proofTimes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "narrativeRole": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "blueprint": {"enum": ["layered-reveal", "map-journey", "archive-stack", "character-procession", "discovery-wipe", "transformation-tableau", "chapter-tableau", "quiet-lockup"]},
          "estimatedDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
          "beats": {"type": "array", "minItems": 3, "items": {"$ref": "storyboard.schema.json#/$defs/beat"}},
          "proofTimes": {"type": "array", "minItems": 3, "items": {"$ref": "storyboard.schema.json#/$defs/proofTime"}}
        },
        "additionalProperties": false
      }
    },
    "sceneTransitions": {"type": "array", "items": {"$ref": "storyboard.schema.json#/$defs/sceneBoundaryTransition"}},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
