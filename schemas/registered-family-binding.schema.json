{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/registered-family-binding.schema.json",
  "title": "Registered Family Manifest Binding",
  "type": "object",
  "required": [
    "schemaVersion",
    "familyId",
    "pattern",
    "registrationId",
    "sourceMasterAssetId",
    "canvas",
    "origin",
    "role",
    "slot",
    "nodeId",
    "source",
    "derivation",
    "recoveryPolicy",
    "familyFingerprint"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "familyId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "pattern": {"const": "supported-subject"},
    "registrationId": {"type": "string", "minLength": 1},
    "sourceMasterAssetId": {"type": "string", "minLength": 1},
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "origin": {"const": "top-left"},
    "role": {"enum": ["support-rear", "subject", "support-front"]},
    "slot": {"enum": ["support-rear", "subject", "support-front"]},
    "nodeId": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": [
        "kind",
        "assetId",
        "stateId",
        "sourceSheetAssetId",
        "sourceFamilyFingerprint",
        "sha256"
      ],
      "properties": {
        "kind": {"enum": ["source-master", "registered-sheet", "registered-sheet-member"]},
        "assetId": {"type": "string", "minLength": 1},
        "stateId": {"type": ["string", "null"]},
        "sourceSheetAssetId": {"type": ["string", "null"]},
        "sourceFamilyFingerprint": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "derivation": {
      "type": "object",
      "required": [
        "placement",
        "maskAssetId",
        "maskSha256",
        "maskChannel",
        "invertMask",
        "clip",
        "trimmed",
        "outputCanvasPreserved"
      ],
      "properties": {
        "placement": {"$ref": "https://local.paper-collage.dev/registered-family.schema.json#/$defs/rect"},
        "maskAssetId": {"type": ["string", "null"]},
        "maskSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "maskChannel": {"enum": ["alpha", "luminance", null]},
        "invertMask": {"type": "boolean"},
        "clip": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://local.paper-collage.dev/registered-family.schema.json#/$defs/clip"}
          ]
        },
        "trimmed": {"const": false},
        "outputCanvasPreserved": {"const": true}
      },
      "additionalProperties": false
    },
    "recoveryPolicy": {
      "$ref": "https://local.paper-collage.dev/registered-family.schema.json#/$defs/recoveryPolicy"
    },
    "familyFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {"const": "support-rear"}
        },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "slot": {"const": "support-rear"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {"const": "subject"}
        },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "slot": {"const": "subject"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {"const": "support-front"}
        },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "slot": {"const": "support-front"}
        }
      }
    }
  ],
  "additionalProperties": false
}
