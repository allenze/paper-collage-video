{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-collage-video.local/schemas/style-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "version", "canonicalSubject", "styles"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 2},
    "version": {"type": "string", "minLength": 1},
    "canonicalSubject": {"type": "string", "minLength": 1},
    "styles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "label", "summary", "image", "profile"],
        "properties": {
          "id": {
            "enum": [
              "childrens-picture-book-paper",
              "hand-drawn-cutout-explainer",
              "archival-collage"
            ]
          },
          "label": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "image": {
            "type": "string",
            "pattern": "^style-catalog/[a-z0-9-]+\\.png$"
          },
          "profile": {
            "$ref": "https://local.paper-collage.dev/style-profile.schema.json#/$defs/definition"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
